{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "typescript": {
      "command": "npx",
      "args": [
        "-y",
        "ts-lsp-mcp"
      ]
    },
    "angular": {
      "command": "npx",
      "args": [
        "-y",
        "@angular/cli@latest",
        "mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated"
      ]
    }
  }
}