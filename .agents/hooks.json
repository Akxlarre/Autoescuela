{
  "koa-guardrails": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/antigravity-pre-write.cjs"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/antigravity-run-command.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/antigravity-post-read.cjs"
          }
        ]
      },
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/antigravity-post-write.cjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/scripts/antigravity-stop.cjs"
      }
    ]
  }
}
